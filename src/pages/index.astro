---
import Base from "../layouts/Base.astro";
import Portada from "../components/Portada.astro";
import Introduccion from "../components/Introduccion.astro";
import Arquitectura from "../components/Arquitectura.astro";
import Mecanismos from "../components/Mecanismos.astro";
import Primitivas from "../components/Primitivas.astro";
import Descargas from "../components/Descargas.astro";
import Pie from "../components/Pie.astro";
---

<Base
  titulo="Secure Documents, proyecto de criptografía"
  descripcion="Arquitectura, mecanismos criptográficos y entregables de un proyecto escolar de Selected Topics in Cryptography."
>
  <Portada />
  <main class="velo">
    <Introduccion />
    <Arquitectura />
    <Mecanismos />
    <Primitivas />
    <Descargas />
  </main>
  <Pie />
  <script>
    import { iniciarEscenas } from "../scripts/escenas";
    import { iniciarLaminas } from "../scripts/raster";
    iniciarEscenas();
    iniciarLaminas();
  </script>
</Base>
